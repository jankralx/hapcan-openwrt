#!/bin/sh /etc/rc.common
# slcan link to the CANable (STM32) on the board, creates can0

START=50
USE_PROCD=1

TTY=/dev/ttyACM0
# slcan bitrate code, 4 = 125 kbit/s used by HAPCAN
BITRATE=4

start_service() {
	[ -c "$TTY" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/slcand -o -c -f -F -s"$BITRATE" "$TTY" can0
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
