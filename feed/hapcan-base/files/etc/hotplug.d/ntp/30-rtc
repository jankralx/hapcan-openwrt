# Write NTP time to the RTC once per boot and after each time step.
# Writing the BQ32000 also clears its oscillator stop flag, so the RTC
# recovers by itself after the battery is replaced.

[ -c /dev/rtc0 ] || exit 0
[ "${stratum:-16}" -lt 16 ] || exit 0

case "$ACTION" in
step) ;;
stratum) [ -e /tmp/.rtc-synced ] && exit 0 ;;
*) exit 0 ;;
esac

hwclock -w -u -f /dev/rtc0 && touch /tmp/.rtc-synced &&
	logger -t rtc "RTC set from NTP"
