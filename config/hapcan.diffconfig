CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_hapcan_interface=y
CONFIG_PACKAGE_canutils=y
CONFIG_PACKAGE_hapcan-base=y
CONFIG_PACKAGE_canutils-candump=y
CONFIG_PACKAGE_canutils-cansend=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_gpiod-tools=y
CONFIG_PACKAGE_openssh-sftp-server=y
# The interface is a network client, not a router
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_PRODUCT="HAPCAN Ethernet Interface"
# Fallback static address (also used by failsafe), next to the DHCP client
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.168.100"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.168.255"
